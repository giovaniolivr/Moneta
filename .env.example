# Copie para .env e ajuste. Gere a chave com:
#   uv run python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=troque-me

# Bancos: NÃO defina DATABASE_URL aqui. Cada perfil já aponta para o seu:
#   - desenvolvimento (runserver, config.settings.dev): db-demo.sqlite3 (dados fictícios);
#   - uso real (scripts/serve.ps1, config.settings.personal): db.sqlite3 (seus dados).
# Assim é impossível desenvolver por engano em cima dos dados reais.

# Uso real pelo Tailscale: nome da máquina mostrado pelo `tailscale serve` (sem https://).
# Vários nomes separados por vírgula.
# MONETA_HOSTS=meu-pc.tail1234.ts.net

# Login automático no runserver local de desenvolvimento (só DEBUG + localhost). 0 para desativar.
# DEV_AUTO_LOGIN=1
# DEV_AUTO_LOGIN_USERNAME=
